i = 1;
while i <= 5 {
    print(i);
    i = i + 1;
}

numbers = [1, 2, 3, 4, 5];
print(numbers[0]); 
print(numbers[4]); 


function add(x, y) {
    return x + y;
}

result = add(10, 5);
print(result);

function factorial(n) {
    result = 1;
    i = 1;
    while i <= n {
        result = result * i;
        i = i + 1;
    }
    return result;
}

num = 5;
print("Factorial of " + num + " is " + factorial(num));